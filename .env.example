# ================= LeafGuard AI environment ==================
# Copy this file to .env and adjust values.

# --- Backend ---
# MongoDB connection string. If MongoDB is unreachable the API falls back to an
# in-memory repository (data is lost on restart) and logs a warning.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=leafguard

# Path to the trained model bundle produced by ml/scripts/train.py
MODEL_PATH=./app/ml/artifacts/leafguard_model.joblib

# Comma-separated list of allowed CORS origins
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Maximum accepted upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend port used by uvicorn
BACKEND_PORT=8000

# --- Frontend (frontend/.env) ---
# Base URL of the REST API consumed by the React app
VITE_API_URL=http://localhost:8000
